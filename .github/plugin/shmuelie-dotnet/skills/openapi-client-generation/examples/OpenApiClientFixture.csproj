<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GeneratedClientDir Condition="'$(GeneratedClientDir)' == ''">$(MSBuildThisFileDirectory)missing-generated</GeneratedClientDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(GeneratedClientDir)\**\*.cs" LinkBase="Generated" />
  </ItemGroup>
</Project>
